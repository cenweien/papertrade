# Local development environment for the market-data Edge Function.
# Auto-loaded by `supabase functions serve market-data` from this directory.
# This file is safe to commit — it contains no real secrets.

# -----------------------------------------------------------------------------
# Bloomberg relay URL — the bloomberg-service Python app (FastAPI) that
# actually talks to Bloomberg SAPI/B-PIPE. Deno Edge Functions can't load
# the `blpapi` native C++ library, so we proxy the call.
#
# Examples:
#   Local dev:     http://localhost:8000
#   LAN box:       http://10.0.0.5:8000
#   Cloudflare Tunnel: https://bloomberg-relay.example.com
# -----------------------------------------------------------------------------
BLOOMBERG_RELAY_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Shared secret sent in the X-API-Key header. Must match the
# RELAY_API_KEY env var on the bloomberg-service Python app. Leave empty
# if the Python service is running with auth disabled (LAN-only mode).
# -----------------------------------------------------------------------------
BLOOMBERG_RELAY_KEY=__REPLACE_WITH_THE_SAME_SECRET_AS_RELAY_API_KEY__

# -----------------------------------------------------------------------------
# Supabase service key — used by getServiceClient() in market-data to read
# and write the `stock_prices` cache table. Either format works:
#   - Legacy:   `eyJ...` service_role JWT (Settings -> API -> Project API keys)
#   - New:      `sb_secret_...` (Settings -> API -> Secret keys)
# -----------------------------------------------------------------------------
SERVICE_KEY=__REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY__
