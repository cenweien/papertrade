# Local development environment for the ai-service Edge Function.
# This file is loaded automatically by `supabase functions serve ai-service`
# from the function's own directory. It is NOT loaded by the deployed function
# (deployed invocations use `supabase secrets set` / dashboard Secrets).
#
# Setup:
#   1. Copy this file to `.env` (same directory):
#        cp supabase/functions/ai-service/.env.example supabase/functions/ai-service/.env
#   2. Replace each placeholder below with the real value.
#   3. Restart `supabase functions serve` so the new env is picked up.
#
# The `.env` file is auto-gitignored by Supabase's standard .gitignore, so it
# is safe to put real secrets in it for local development.

# -----------------------------------------------------------------------------
# Google Gemini API key (used by parseCommand to call the LLM for natural-
# language trade parsing). Get a free key at:
#   https://aistudio.google.com/apikey
# Free tier: 15 RPM, 1500 RPD, 1M TPM — plenty for a paper-trading demo.
#   - If your key contains a `$`, wrap the value in single quotes when setting
#     it via shell: $env:GEMINI_API_KEY = 'AIza...$...'
#   - Or just paste the real value directly into this file.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=__REPLACE_WITH_YOUR_GOOGLE_AI_STUDIO_KEY__

# -----------------------------------------------------------------------------
# Gemini model id. Optional — defaults to 'gemini-2.5-flash' if unset.
# Other free-tier options:
#   - 'gemini-2.5-flash-lite'  (fastest, lowest quota usage)
#   - 'gemini-2.5-pro'         (slower, smartest, tighter free quota)
# See https://ai.google.dev/gemini-api/docs/models for the full list.
# -----------------------------------------------------------------------------
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Supabase service key — used by the supabase-js service client inside the
# function for DB reads/writes (portfolios, ai_chat_history, stock_prices).
#
# Two acceptable formats (Supabase supports both for the supabase-js client):
#   - Legacy:   the `service_role` JWT from Settings -> API -> Project API keys
#               (looks like: eyJhbGciOiJIUzI1NiIs...)
#   - New:      a Secret key from Settings -> API -> Secret keys
#               (looks like: sb_secret_...)
#
# For hosted deployment (`supabase secrets set SERVICE_KEY=...`) the legacy
# `eyJ...` JWT is required if the function ever makes outbound calls to other
# edge functions using `apikey: SERVICE_KEY`. For local dev, either works.
#
# Note: The ai-service does NOT call the Bloomberg relay directly. It reads
# from the `stock_prices` cache table (populated by the market-data Edge
# Function, which itself relays to bloomberg-service). So no BLOOMBERG_*
# vars are needed here.
# -----------------------------------------------------------------------------
SERVICE_KEY=__REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY__
