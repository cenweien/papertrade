# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
# Use the NEW publishable key (sb_publishable_...) — the legacy JWT anon key is deprecated.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key-here

# Market Data
# Finnhub.io API key (free tier, 60 calls/min). Used by the Supabase market-data
# Edge Function. The key is set as a secret on the function, NOT here — this
# is just a reminder comment for local dev. Get a key at https://finnhub.io/register
# Then run: supabase secrets set FINNHUB_API_KEY=your_key
# VITE_FINNHUB_API_KEY=your_finnhub_key_here
</content>
</invoke>