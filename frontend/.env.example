# Copy this file to frontend/.env.local and edit the values for your setup.
#
# === Quick local mode (no Supabase, no Cloudflare tunnel) ===
# The defaults below let you run with just the bloomberg-service Python relay
# on localhost:8000. The login page is auto-bypassed and prices come straight
# from the relay — no Supabase project needed.
#
# === Full production mode ===
# Fill in the Supabase URL/anon-key, leave VITE_AUTH_MODE and VITE_DATA_MODE
# unset (or set to "supabase"), and the app talks to Supabase exactly like
# the deployed Vercel build. The Cloudflare-tunnel path documented in
# SETUP.md is unaffected.

# ----------------------------
# Mode switches (local-only)
# ----------------------------
# VITE_AUTH_MODE:
#   - "mock"    : skip login, auto-sign in as a stub user. No backend call.
#   - anything else (or unset): normal Supabase auth flow.
VITE_AUTH_MODE=mock

# VITE_DATA_MODE:
#   - "direct"  : frontend hits the Python relay on VITE_RELAY_URL directly.
#   - anything else (or unset): frontend goes through Supabase Edge Functions
#                               (the deployed Vercel/Cloudflare path).
VITE_DATA_MODE=direct

# ----------------------------
# Direct relay (only used when VITE_DATA_MODE=direct)
# ----------------------------
VITE_RELAY_URL=http://localhost:8000
# Leave blank to disable the X-API-Key header (matches the AUTH_DISABLED=true
# default of bloomberg-service/app.py when starting in "no auth" mode).
VITE_RELAY_API_KEY=

# ----------------------------
# Supabase (only used when VITE_AUTH_MODE != "mock" or VITE_DATA_MODE != "direct")
# ----------------------------
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
