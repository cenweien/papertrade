# Bloomberg SAPI connection (override xbbg_sapi's hardcoded defaults)
# These default to the values found in xbbg_sapi/core.py. Override them
# if your firm uses a different B-PIPE endpoint or your own credentials.
BBG_HOST=10.103.1.46
BBG_PORT=8194
# Optional - leave blank to use the hardcoded UUIDs in xbbg_sapi
BBG_UUID=
BBG_USER_IP=

# Shared secret for the X-API-Key header.
#
# In the Vercel + Cloudflare-tunnel production path (see SETUP.md) this
# value is required and matches the BLOOMBERG_RELAY_KEY Supabase secret.
# The service warns (does NOT hard-fail) at startup when both
# RELAY_API_KEY and AUTH_DISABLED are empty — that's intentional, so the
# local-only path (frontend <-> uvicorn on localhost) just works. DO NOT
# expose the service over a public tunnel without a key.
RELAY_API_KEY=
# Uncomment to make the no-auth posture explicit (recommended for the
# local-only path so the warning at startup goes away).
AUTH_DISABLED=true

# Supabase service-role credentials (for the scheduler to write to stock_prices)
# Use the same SERVICE_KEY you configured for market-data / ai-service.
# Leave blank if you run frontend/relay in local-only mode without the scheduler.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Shared secret for calling the `compute-snapshots` Edge Function.
# Must match the INTERNAL_API_KEY Supabase secret set on the edge
# function side (Supabase dashboard -> Edge Functions -> Secrets).
# The scheduler uses this to write daily portfolio equity snapshots
# (Tier 3 follow-up to .kilo/plans/tier1-tier2-risk-improvements.md).
# Leave blank if you don't run the scheduler in local-only mode.
INTERNAL_API_KEY=

# Scheduler tuning
REFRESH_INTERVAL=300       # seconds between refresh cycles (5 min)
CLEANUP_INTERVAL=3600      # seconds between stale-row cleanup (1 hour)
SNAPSHOT_TICK_HOUR=23      # UTC hour at which to call compute-snapshots
SNAPSHOT_TICK_MINUTE=55    # UTC minute at which to call compute-snapshots

# Logging
LOG_LEVEL=INFO
