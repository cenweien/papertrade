# Bloomberg SAPI connection (override xbbg_sapi's hardcoded defaults)
# These default to the values found in xbbg_sapi/core.py. Override them
# if your firm uses a different B-PIPE endpoint or your own credentials.
BBG_HOST=10.103.1.46
BBG_PORT=8194
# Optional - leave blank to use the hardcoded UUIDs in xbbg_sapi
BBG_UUID=
BBG_USER_IP=

# Shared secret for the X-API-Key header. The Supabase market-data Edge
# Function is configured with the same value via
# `supabase secrets set BLOOMBERG_RELAY_KEY=...`
#
# REQUIRED. The service is reached via a public Cloudflare tunnel, so
# an empty key would expose the Bloomberg SAPI relay to the internet.
# To run with no auth (only safe behind a firewall that blocks public
# traffic), explicitly set AUTH_DISABLED=true — otherwise the service
# will hard-fail at startup.
RELAY_API_KEY=__REPLACE_WITH_A_RANDOM_SECRET__
# AUTH_DISABLED=true    # uncomment ONLY if the service is behind a firewall

# Supabase service-role credentials (for the scheduler to write to stock_prices)
# Use the same SERVICE_KEY you configured for market-data / ai-service.
SUPABASE_URL=https://cygsvvhdkpnqxfuoqkyq.supabase.co
SUPABASE_SERVICE_KEY=__REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY__

# Scheduler tuning
REFRESH_INTERVAL=300       # seconds between refresh cycles (5 min)
CLEANUP_INTERVAL=3600      # seconds between stale-row cleanup (1 hour)

# Logging
LOG_LEVEL=INFO
